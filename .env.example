# Copy this file to .env (in the project root) and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-key-here
# Run scripts/list_models.py to see which model names your key can use.
GEMINI_MODEL=gemini-flash-latest
# Optional, comma-separated models to try after GEMINI_MODEL (others are discovered automatically).
GEMINI_FALLBACK_MODELS=
# Optional.
GEMINI_MAX_OUTPUT_TOKENS=32000
# Optional: seconds per Gemini call (default 300) and for the whole run incl. retries and fallbacks (default 480).
GEMINI_CALL_TIMEOUT=
GEMINI_TOTAL_BUDGET=
# Optional, set at most one: thinking tokens (0 = off, -1 = automatic; Gemini 2.5 style)
# or thinking level minimal|low|medium|high (Gemini 3 style). Empty = model default.
GEMINI_THINKING_BUDGET=
GEMINI_THINKING_LEVEL=
